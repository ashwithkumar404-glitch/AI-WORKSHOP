# CampusPilot AI — Environment Configuration
# Sahyadri College of Engineering and Management (SCEM), Mangaluru

# ==============================================================================
# FRONTEND / CLIENT-SIDE VARIABLES (SAFE TO EXPOSE IN CLIENT BUNDLE)
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public API Key / Publishable Key (Row Level Security protected)
# You may set either VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY.
# NEVER put the service_role key here!
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Institutional Email Domain Restrictions
# Restricts Google OAuth registration and email signups to specific domains.
# - "sahyadri.edu.in" restricts to Sahyadri College Google accounts.
# - Comma-separated: "sahyadri.edu.in,alumni.sahyadri.edu.in"
# - Leave empty or set to "*" to allow any verified Google account (e.g. for development/open testing).
VITE_ALLOWED_EMAIL_DOMAINS=sahyadri.edu.in

# Explicit Demo / Development Sandbox Toggle
# - "false" enforces strict live Supabase authentication only.
# - "true" enables local offline sandbox personas (Aditi / Dr. Kamath) alongside Supabase.
# - If unset, defaults to true only when Supabase is unconfigured.
VITE_ENABLE_DEMO_MODE=false

# Optional: Server-side AI Proxy URL if hosting an LLM endpoint
# If unset, CampusPilot AI uses its grounded RAG knowledge engine with OpenRouter/Gemini fallback.
VITE_AI_PROXY_URL=

# ==============================================================================
# BACKEND / SERVER-SIDE ONLY SECRETS (DO NOT COMMIT OR PREFIX WITH VITE_)
# ==============================================================================

# Supabase Service Role Key (Used ONLY in migrations, seeds, or trusted backend/Edge Functions)
# NEVER put this key in any frontend code or client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-in-client

# Supported LLM API Key (Keep strictly server-side / in Edge Function secrets)
GEMINI_API_KEY=your-gemini-api-key-for-edge-functions

# Direct PostgreSQL Database Connection String (for psql, Prisma, or Supabase CLI migrations)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
