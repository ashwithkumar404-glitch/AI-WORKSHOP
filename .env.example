# CampusPilot AI — Environment Configuration
# Sahyadri College of Engineering and Management (SCEM)

# ==============================================================================
# FRONTEND / CLIENT-SIDE VARIABLES (SAFE TO EXPOSE IN CLIENT BUNDLE)
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon/Public Key (Row Level Security protected)
# NEVER put the service_role key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Server-side AI Proxy URL if hosting an LLM endpoint
# If unset, CampusPilot AI uses its offline high-precision grounded knowledge engine
VITE_AI_PROXY_URL=

# ==============================================================================
# BACKEND / SERVER-SIDE ONLY SECRETS (DO NOT COMMIT OR PREFIX WITH VITE_)
# ==============================================================================

# Supabase Service Role Key (Only used in trusted Edge Functions / Migration scripts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-in-client

# Supported LLM API Key (Keep strictly server-side / in Edge Function secrets)
# Gemini API Key / OpenAI API Key
GEMINI_API_KEY=your-gemini-api-key-for-edge-functions

# Database Direct Connection String (For running PostgreSQL migrations via psql or Supabase CLI)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
